# Poster server configuration. Copy this file to .env and fill it in.
# Real environment variables take precedence over values in .env.

# --- Ollama (AI captions) -----------------------------------------------------
# Base URL, or a full .../api/chat or .../v1/chat/completions URL.
OLLAMA_ENDPOINT=https://ollama.com
# Required for Ollama Cloud (ollama.com -> Settings -> Keys); optional for self-hosted Ollama.
OLLAMA_API_KEY=
MODEL=gemma4:31b
# Optional: the only models the browser may choose (comma-separated; MODEL is always allowed).
# Empty allows any model name.
OLLAMA_MODELS=

# --- Buffer (scheduling) ------------------------------------------------------
# Personal API key from Buffer (Settings -> API).
BUFFER_ACCESS_TOKEN=
BUFFER_API_URL=https://api.buffer.com

# --- Media host (optional) ----------------------------------------------------
# Buffer attaches images from public URLs only. Poster uploads each image to
# Vercel Blob when BLOB_READ_WRITE_TOKEN is set (the store must be public), from
# the store's page in the Vercel dashboard:
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# With Vercel Blob, Poster stores a thumbnail and a compressed AVIF copy of each
# image (never the original file) and gives Buffer this server's URL for it:
# <PUBLIC_BASE_URL>/api/media/image/<name>.jpg. On Vercel it is the address you
# opened Poster at; elsewhere set the server's public https:// address here.
PUBLIC_BASE_URL=
# Otherwise set an upload endpoint that returns a public URL, e.g. a Cloudinary
# unsigned upload preset:
#   MEDIA_UPLOAD_ENDPOINT=https://api.cloudinary.com/v1_1/<cloud-name>/image/upload
#   MEDIA_UPLOAD_PRESET=<unsigned-preset>
MEDIA_UPLOAD_ENDPOINT=
MEDIA_UPLOAD_PRESET=

# --- Pollinations (AI image generation, optional) ------------------------------
# Lets you generate images from a written description instead of uploading
# them. Free API key from enter.pollinations.ai.
POLLINATIONS_API_KEY=

# --- Server -------------------------------------------------------------------
# auto = Live when Ollama is configured, otherwise Demo.
POSTER_MODE=auto
# Password for the dashboard and its API (HTTP Basic auth; any user name).
# Required whenever Poster is reachable on anything but a local address, for
# example on Vercel: without it, such requests are refused. Use a long random
# value. Buffer still fetches post images (/api/media/image/) without it.
POSTER_PASSWORD=
# Keep 127.0.0.1 unless you set POSTER_PASSWORD.
POSTER_HOST=127.0.0.1
POSTER_PORT=5000
OLLAMA_TIMEOUT=120
BUFFER_TIMEOUT=30
MEDIA_TIMEOUT=120
POLLINATIONS_TIMEOUT=60
# Seconds one request may spend on upstream calls, retries included (0 = no limit).
# Defaults to 280 on Vercel, which stops functions after 300 s (vercel.json).
POSTER_REQUEST_BUDGET=
FLASK_DEBUG=0
