# Poster server configuration. Copy this file to .env and fill it in.
# Real environment variables take precedence over values in .env.

# --- Groq (AI captions) -------------------------------------------------------
# OpenAI-compatible base URL, or the full .../chat/completions URL.
GROQ_ENDPOINT=https://api.groq.com/openai/v1
# Required: console.groq.com -> API Keys.
GROQ_API_KEY=
# A model that accepts images (console.groq.com/docs/vision); text-only models such as openai/gpt-oss-120b fail.
MODEL=qwen/qwen3.8-27b
# Optional: the only models the browser may choose (comma-separated; MODEL is always allowed).
# Empty allows any model name.
GROQ_MODELS=

# --- Facebook and Instagram (Meta Graph API) ---------------------------------
# A system user token from Meta Business settings with pages_show_list,
# pages_read_engagement, pages_manage_posts, instagram_basic,
# instagram_content_publish and business_management (README: Connect Facebook
# and Instagram). Each Page it manages, and the Instagram account linked to
# the Page, becomes a channel.
META_ACCESS_TOKEN=
# Optional: the app secret (App settings -> Basic). Every call then carries an appsecret_proof.
META_APP_SECRET=
# The Graph API version Poster calls. Meta retires each version about two years after its release.
META_GRAPH_VERSION=v23.0

# --- Post queue and publisher ---------------------------------------------------
# Scheduled posts wait in a Postgres database until they are published, and the
# activity log is kept there too. On
# Vercel, the Supabase or Neon integration sets POSTGRES_URL, which Poster uses;
# DATABASE_URL takes precedence. Locally, without either, Poster uses poster.db
# (SQLite) next to app.py.
DATABASE_URL=
# The publisher runs when something calls GET /api/publish/due with
# "Authorization: Bearer <CRON_SECRET>", every minute: cron-job.org on Vercel
# Hobby, Vercel Cron on Pro. python app.py publishes by itself while it runs.
CRON_SECRET=

# --- Media host (optional) ----------------------------------------------------
# Facebook and Instagram fetch images from public URLs only, when each post is
# published. Poster uploads each image to Vercel Blob when BLOB_READ_WRITE_TOKEN
# is set (the store must be public), from the store's page in the Vercel dashboard:
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# With Vercel Blob, Poster stores a thumbnail and a compressed AVIF copy of each
# image (never the original file) and gives Meta this server's URL for it:
# <PUBLIC_BASE_URL>/api/media/image/<name>.jpg. On Vercel it is the address you
# opened Poster at; elsewhere set the server's public https:// address here.
PUBLIC_BASE_URL=
# Otherwise set an upload endpoint that returns a public URL, e.g. a Cloudinary
# unsigned upload preset:
#   MEDIA_UPLOAD_ENDPOINT=https://api.cloudinary.com/v1_1/<cloud-name>/image/upload
#   MEDIA_UPLOAD_PRESET=<unsigned-preset>
MEDIA_UPLOAD_ENDPOINT=
MEDIA_UPLOAD_PRESET=

# --- Pollinations (AI image generation, optional) ------------------------------
# Lets you generate images from a written description instead of uploading
# them, or change an uploaded image as you describe ("Edit with AI"). Free API
# key from enter.pollinations.ai.
POLLINATIONS_API_KEY=
# Model for "Edit with AI". kontext (FLUX.1 Kontext) is on the free tier; any
# model whose supported_endpoints in gen.pollinations.ai/image/models include
# /v1/images/edits works, e.g. nanobanana or gptimage (paid).
POLLINATIONS_EDIT_MODEL=kontext

# --- Server -------------------------------------------------------------------
# auto = Live when Groq is configured, otherwise Demo.
POSTER_MODE=auto
# Password for the dashboard and its API (HTTP Basic auth; any user name).
# Required whenever Poster is reachable on anything but a local address, for
# example on Vercel: without it, such requests are refused. Use a long random
# value. Meta still fetches post images (/api/media/image/) without it, and the
# publisher's scheduler sends CRON_SECRET instead.
POSTER_PASSWORD=
# Keep 127.0.0.1 unless you set POSTER_PASSWORD.
POSTER_HOST=127.0.0.1
POSTER_PORT=5000
GROQ_TIMEOUT=120
META_TIMEOUT=30
MEDIA_TIMEOUT=120
POLLINATIONS_TIMEOUT=60
# Seconds one request may spend on upstream calls, retries included (0 = no limit).
# Defaults to 280 on Vercel, which stops functions after 300 s (vercel.json).
POSTER_REQUEST_BUDGET=
FLASK_DEBUG=0
